{
  "name": "@zyra/auth-service",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/auth-service/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/auth-service/src/main.ts",
          "tsConfig": "apps/auth-service/tsconfig.app.json",
          "assets": [
            "apps/auth-service/src/assets",
            {
              "input": "apps/auth-service/src",
              "glob": "swagger-output.json",
              "output": "."
            }
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "external": [
              "@prisma/client",
              "@prisma/engines",
              "ioredis"
            ]
          }
        },
        "configurations": {
          "development": {
            "esbuildOptions": {
              "sourcemap": true,
              "external": [
                "@prisma/client",
                "@prisma/engines",
                "ioredis"
              ]
            }
          },
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "external": [
                "@prisma/client",
                "@prisma/engines",
                "ioredis"
              ]
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/package.json",
          "{workspaceRoot}/apps/auth-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@zyra/auth-service:build",
          "runBuildTargetDependencies": false,
          "host": "localhost"
        },
        "runtimeArgs": [
          "--env-file=.env"
        ],
        "configurations": {
          "development": {
            "buildTarget": "@zyra/auth-service:build:development"
          },
          "production": {
            "buildTarget": "@zyra/auth-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^4.21.2",
    "redis": "^4.6.0",
    "tsconfig-paths": "^4.2.0"
  }
}
